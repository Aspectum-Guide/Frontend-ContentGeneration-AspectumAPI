{
  "name": "aspectum-admin-content-generation",
  "version": "1.0.0",
  "type": "module",
  "description": "Aspectum Admin - Content Generation Platform",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:studio": "node scripts/build-scope.mjs studio",
    "build:catalog": "node scripts/build-scope.mjs catalog",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx,ts,tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "codegen": "openapi-typescript openapi/schema.yaml -o src/types/api.generated.ts",
    "codegen:fetch": "node scripts/openapi-fetch.js",
    "codegen:sync": "npm run codegen:fetch && npm run codegen",
    "codegen:verify": "node scripts/openapi-verify.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.0",
    "@sentry/react": "^10.67.0",
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.6.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.59.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.0",
    "react-router-dom": "^7.18.4",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "^24.0.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
